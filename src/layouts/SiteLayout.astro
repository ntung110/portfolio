---
import { getEntry } from "astro:content";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { siteContent } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  active: "about" | "projects" | "writings";
  listing?: boolean;
}

const { title, description = siteContent.description, active, listing = false } = Astro.props;
const about = await getEntry("pages", "about");
if (!about) throw new Error("Missing About content: add src/content/about.md");
const { name } = about.data;
const pageTitle = title ? `${title} — ${name}` : name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/pp-neue-montreal-variable.woff2" as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class:list={["site-shell", { "about-shell": active === "about" }]}>
      <Navigation active={active} />
      <main id="main-content" class:list={["main-content", { "listing-page": listing }]} tabindex="-1">
        <slot />
      </main>
      <Footer name={name} />
    </div>
  </body>
</html>
